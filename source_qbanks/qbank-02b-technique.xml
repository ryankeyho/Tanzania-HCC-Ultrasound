  <question type="multichoice">
    <name><text>Q019</text></name>
    <questiontext format="html"><text><![CDATA[<p>On a transverse view at the porta hepatis, the 'Mickey Mouse' arrangement consists of:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The portal vein forms the head; the hepatic artery and CBD sit anteriorly as the ears.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Portal vein as the head, with hepatic artery and common bile duct as the two ears]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Gallbladder as the head, with cystic duct as ears]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[IVC as the head, with hepatic veins as ears]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
