  <question type="multichoice">
    <name><text>Q015</text></name>
    <questiontext format="html"><text><![CDATA[<p>A patient physically cannot sustain a breath-hold. The appropriate adaptation is:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The study can still be diagnostic; what matters is adapting technique and documenting the limitation honestly.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
