      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Improve far-field brightness]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Displace bowel gas]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Move between transverse, sagittal and oblique scan planes]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q008</text></name>
    <questiontext format="html"><text><![CDATA[<p>Rocking (heel-toe) the probe is most useful when:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Rocking tilts along the probe's long axis within the scan plane, improving contact and bringing a structure toward the center of the image.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Only part of the footprint is in contact, such as over ribs]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The gain is too high]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[You need a second plane]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The patient cannot hold their breath]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q009</text></name>
    <questiontext format="html"><text><![CDATA[<p>Graded compression during a liver survey is used primarily to:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Compression pushes gas out of the beam. Apply it gradually - discomfort costs you the breath-hold, which costs more than the gas did.</p>]]></text></generalfeedback>
