  <question type="multichoice">
    <name><text>Q012</text></name>
    <questiontext format="html"><text><![CDATA[<p>Sitting the patient erect during a liver study is most useful to:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Gravity lowers the liver a few centimetres and mobilises gallbladder contents - a useful rescue maneuver.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Improve Doppler sensitivity]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Drop the liver below the costal margin when subcostal views fail, and shift gallbladder contents]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Eliminate rib shadow]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
