    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Improve Doppler angle]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Reduce the frequency]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Increase frame rate]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Displace bowel gas and shorten the distance to the target]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q010</text></name>
    <questiontext format="html"><text><![CDATA[<p>The liver and gallbladder are hard to see with the patient supine. Which position does ACEP Sonoguide suggest trying?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Lying on the left side, or sitting more upright, shifts the liver and gallbladder and makes them easier to image (ACEP Sonoguide).</p>]]></text></generalfeedback>
