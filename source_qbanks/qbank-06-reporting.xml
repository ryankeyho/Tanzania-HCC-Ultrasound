      <text><![CDATA[Reassure]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Refer for multiphase CT or MRI]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
