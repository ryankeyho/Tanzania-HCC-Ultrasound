    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Refer for CT]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Repeat ultrasound in 3 months]]></text>
      <feedback format="html"><text></text></feedback>
