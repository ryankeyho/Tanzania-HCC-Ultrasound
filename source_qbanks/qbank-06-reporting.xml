  <question type="multichoice">
    <name><text>Q021</text></name>
    <questiontext format="html"><text><![CDATA[<p>An operator is uncertain whether a heterogeneous area represents a lesion or background cirrhotic texture. The correct action is:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Escalation with stored images is the designed safety net; uncertainty resolved by guessing in either direction is unsafe.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Report as normal]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Delete and rescan next visit]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Report as HCC]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Store representative images and escalate for expert over-read before finalizing]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q022</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which describes the correct relationship between the screening operator and the diagnostic pathway?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Screening assigns a category and an action; it does not adjudicate diagnosis.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The operator selects the treatment]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The operator decides whether referral is worthwhile]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The operator classifies the study and triggers a predefined next step; diagnosis occurs downstream]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The operator makes the final diagnosis]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q023</text></name>
    <questiontext format="html"><text><![CDATA[<p>Reporting a lesion's location by Couinaud segment rather than 'right lobe' matters because:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Vague localization breaks the interval comparison the whole surveillance model depends on.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[It is required by AFP protocols]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It is more concise]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[It allows the same lesion to be re-identified on follow-up ultrasound and correlated with CT or MRI]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It changes the recall threshold]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
