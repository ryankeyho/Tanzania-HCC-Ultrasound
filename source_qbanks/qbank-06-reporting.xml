    <answer fraction="0" format="html">
      <text><![CDATA[Cancer has been ruled out]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Further screening is unnecessary]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The result guarantees a good outcome]]></text>
      <feedback format="html"><text></text></feedback>
