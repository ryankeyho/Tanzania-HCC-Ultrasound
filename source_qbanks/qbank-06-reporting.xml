      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q013</text></name>
    <questiontext format="html"><text><![CDATA[<p>A 38-year-old non-cirrhotic HBV carrier. Adequate study. A 1.6 cm lesion previously characterized as a hemangioma on contrast-enhanced CT or MRI, uniformly hyperechoic with posterior enhancement on ultrasound, unchanged over three years. The appropriate recommendation is:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Prior characterization as a hemangioma on appropriate diagnostic imaging, combined with documented multi-year B-mode stability, does not warrant recall. B-mode stability and appearance alone, without that prior cross-sectional characterization, would not be sufficient to call a lesion this size definitively benign.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Refer urgently for CT]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Biopsy]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Repeat in 1 month]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Document as a stable lesion with benign features and continue routine surveillance]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
