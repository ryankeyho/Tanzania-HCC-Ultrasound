  <question type="multichoice">
    <name><text>Q016</text></name>
    <questiontext format="html"><text><![CDATA[<p>A screening study shows three discrete lesions of 1.2, 1.8, and 2.4 cm in a cirrhotic liver. The report should:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Multifocality changes staging and treatment options, so lesion count belongs in the report.</p>]]></text></generalfeedback>
