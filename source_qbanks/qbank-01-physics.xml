  <question type="multichoice">
    <name><text>Q003</text></name>
    <questiontext format="html"><text><![CDATA[<p>Time-gain compensation (TGC) is used to:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>TGC selectively boosts gain with depth to offset attenuation. Different tissues should still keep their different echogenicity; the aim is comparable tissue with appropriate brightness at different depths, not everything equally bright.</p>]]></text></generalfeedback>
