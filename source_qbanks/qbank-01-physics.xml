  <question type="multichoice">
    <name><text>Q001</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which probe is best suited for imaging the liver at standard depths in an adult patient?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Lower frequency trades resolution for the penetration depth abdominal imaging needs.</p>]]></text></generalfeedback>
