      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The coeliac trunk dividing into common hepatic and splenic arteries]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The portal confluence]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The renal arteries]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q005</text></name>
    <questiontext format="html"><text><![CDATA[<p>The superior mesenteric artery is recognisable in cross-section by:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The fat collar around the SMA in cross-section is its most distinctive feature.</p>]]></text></generalfeedback>
