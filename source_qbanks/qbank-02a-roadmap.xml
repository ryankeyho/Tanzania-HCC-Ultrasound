    <answer fraction="100" format="html">
      <text><![CDATA[Confirm bearings, and catch gross extrahepatic abnormality, at low time cost]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Replace the liver protocol]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Measure every vessel]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Satisfy documentation requirements]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q012</text></name>
    <questiontext format="html"><text><![CDATA[<p>Vessels make good orientation landmarks primarily because:</p>]]></text></questiontext>
