      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The confluence of the splenic vein and superior mesenteric vein]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The coeliac trunk]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The porta hepatis]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
