  <question type="multichoice">
    <name><text>Q001</text></name>
    <questiontext format="html"><text><![CDATA[<p>The most reliable first structure to identify on a transverse epigastric view is:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The spine is unmistakable even on a poor image, and everything else is anterior to it.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[The gallbladder]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The pancreatic tail]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The left kidney]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[The spine, with the aorta immediately anterior to it]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q002</text></name>
    <questiontext format="html"><text><![CDATA[<p>On a transverse epigastric image, the IVC lies:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The IVC sits to the patient's right, which appears on the viewer's left in standard orientation.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[To the patient's left of the aorta]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[To the patient's right of the aorta]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Posterior to the vertebral body]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Directly anterior to the aorta]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q003</text></name>
    <questiontext format="html"><text><![CDATA[<p>The fastest way to distinguish the IVC from the aorta, without changing any machine setting, is to:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Compression is instant and needs no settings change. Color Doppler works too but is slower.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Apply probe compression - the IVC compresses, the aorta does not]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Increase the gain]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Increase depth]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Switch to the linear probe]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q004</text></name>
    <questiontext format="html"><text><![CDATA[<p>The 'seagull' appearance on a transverse epigastric view represents:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The coeliac trunk's immediate bifurcation produces the seagull or whale's-tail appearance.</p>]]></text></generalfeedback>
