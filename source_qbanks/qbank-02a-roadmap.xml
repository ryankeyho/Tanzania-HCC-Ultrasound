    <answer fraction="100" format="html">
      <text><![CDATA[The echogenic collar of fat surrounding it]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Its compressibility]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Its bifurcation into two branches]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Its position posterior to the aorta]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q006</text></name>
    <questiontext format="html"><text><![CDATA[<p>The most efficient way to locate the pancreas is to:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The vein is the landmark and the gland follows it; hunting for the gland directly wastes time.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[Start from the left kidney]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Find the gallbladder first]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[Find the splenic vein - the pancreas drapes over it along its length]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Search the epigastrium systematically for glandular tissue]]></text>
      <feedback format="html"><text></text></feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name><text>Q007</text></name>
    <questiontext format="html"><text><![CDATA[<p>The portal vein begins at:</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The splenic-SMV confluence is the origin of the portal vein, and following the splenic vein rightward finds it.</p>]]></text></generalfeedback>
